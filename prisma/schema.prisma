// ============================================================================
// NOTE: generator client and datasource db blocks already exist in your file.
// Append/replace with everything below.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ----------------------------------------------------------------------------
// ENUM
// ----------------------------------------------------------------------------

enum Role {
  Passanger
  Agent
  Admin
  SuperAdmin
  Driver
}

// ----------------------------------------------------------------------------
// USER  (merged: your fields + Better Auth required fields)
// ----------------------------------------------------------------------------

model User {
  id            String   @id                    // Better Auth requires String UUID
  // Better Auth core fields
  name          String
  email         String   @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Your custom fields
  username      String   @unique
  firstName     String
  lastName      String
  phoneNumber   String
  passwd        String
  status        String   @default("active")
  role          Role     @default(Passanger)

  // Better Auth relations
  sessions      Session[]
  accounts      Account[]

  // 1-1 inheritance: a User may also be a Driver
  driver        Driver?

  // 1-N: a User can make many reservations (reservation.userId is optional)
  reservations  Reservation[]

  @@index([role])
}

// ----------------------------------------------------------------------------
// BETTER AUTH — Session
// ----------------------------------------------------------------------------

model Session {
  id          String   @id
  expiresAt   DateTime
  token       String   @unique
  createdAt   DateTime
  updatedAt   DateTime

  // Better Auth writes these on sign-in (optional so existing rows are unaffected)
  ipAddress   String?
  userAgent   String?

  userId      String
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ----------------------------------------------------------------------------
// BETTER AUTH — Account
// ----------------------------------------------------------------------------

model Account {
  id           String  @id
  accountId    String
  providerId   String
  accessToken  String?
  refreshToken String?
  idToken      String?
  password     String?
  createdAt    DateTime
  updatedAt    DateTime

  userId       String
  user         User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ----------------------------------------------------------------------------
// BETTER AUTH — Verification
// ----------------------------------------------------------------------------

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ----------------------------------------------------------------------------
// DRIVER  (subclass of User — shares the same primary key / table-per-type)
// id is now String to match User.id
// ----------------------------------------------------------------------------

model Driver {
  id                     String   @id
  user                   User     @relation(fields: [id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  cin                    Int      @unique
  professionalIdCard     String   @unique
  professionalCardExpiry DateTime
  drivingLicence         Int
  drivingLicenceExpiry   DateTime

  // 1-N: a Driver can perform many entrances
  entrances              Entrance[]
}

// ----------------------------------------------------------------------------
// STATION
// ----------------------------------------------------------------------------

model Station {
  id           Int      @id @default(autoincrement())
  name         String
  governorate  String
  city         String
  latitude     Float
  longitude    Float
  creationDate DateTime @default(now())
  gpsRadius    Float

  routes    Route[] @relation("RouteStations")
  entrances Entrance[]

  @@index([governorate, city])
}

// ----------------------------------------------------------------------------
// ROUTE
// ----------------------------------------------------------------------------

model Route {
  id                Int    @id @default(autoincrement())
  name              String
  routeNumber       Int
  firstDestination  String
  secondDestination String // NOTE: must differ from firstDestination — enforced at application level
  fee               Float
  altitude          Float
  description       String

  stations  Station[] @relation("RouteStations")

  vehicles Vehicle[]

}

// ----------------------------------------------------------------------------
// VEHICLE
// ----------------------------------------------------------------------------

model Vehicle {
  id                 Int      @id @default(autoincrement())
  registrationNumber Int      @unique
  seriesNumber       Int
  carBrand           String
  capacity           Int      @default(8)
  status             String   @default("active")
  chassisNumber      String   @unique
  insuranceExpiry    DateTime
  registrationDate   DateTime
  inspectionExpiry   DateTime

  routeId Int?
  route   Route? @relation(fields: [routeId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  entrances Entrance[]

  @@index([routeId])
}

// ----------------------------------------------------------------------------
// ENTRANCE  (association entity resolving the Station <-> Vehicle M-N)
// ----------------------------------------------------------------------------

model Entrance {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  vehicleId Int
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  stationId Int
  station   Station @relation(fields: [stationId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  driverId  String
  driver    Driver @relation(fields: [driverId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  reservations Reservation[]

  @@index([vehicleId])
  @@index([stationId])
  @@index([driverId])
}

// ----------------------------------------------------------------------------
// RESERVATION
// ----------------------------------------------------------------------------

model Reservation {
  id            Int      @id @default(autoincrement())
  numberOfSeats Int
  createdAt     DateTime @default(now())

  entranceId Int
  entrance   Entrance @relation(fields: [entranceId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([entranceId])
  @@index([userId])
}
